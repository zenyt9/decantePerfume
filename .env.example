# =====================================================================
#  Орчны хувьсагчид (Railway → Variables хэсэгт тохируулна)
#  Энэ файл нь ЖИШЭЭ. Жинхэнэ утгыг Railway дээр оруулна (.env-г repo-д бүү нэм).
# =====================================================================

# Volume-ийн mount path — өгөгдлийн сан (db.json) энд хадгалагдана.
# Railway дээр Volume үүсгээд mount path-ийг /data болгосон бол:
DATA_DIR=/data

# HTTPS дээр cookie-г Secure болгох (Railway домэйн HTTPS тул 1 болго):
SECURE_COOKIES=1

# Анхны админ (зөвхөн сан ХООСОН үед үүсэхэд ашиглагдана):
ADMIN_EMAIL=admin@decante.mn
ADMIN_PASSWORD=CHANGE_ME_хүчтэй_нууц_үг

# PORT-ыг Railway АВТОМАТААР өгнө — гараар бүү тохируул.
